# Copy to .env and fill in real values.

# Web Push (VAPID): generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@quickxlearn.com

# Payments. PAYSTACK_SECRET_KEY is required: every Paystack payment is confirmed
# with it before anything is granted. Without it, card / Paystack checkout is refused.
PAYSTACK_SECRET_KEY=
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=

# Local development only: accept payments without contacting the provider.
# NEVER set this on a live server: it lets anyone buy without paying.
# ALLOW_SIMULATED_PAYMENTS=true

# The mentor's User id. Optional: defaults to the approved tutor named OWNER_NAME ("Maxwell").
OWNER_USER_ID=
OWNER_NAME=Maxwell
